# ─────────────────────────────────────────────
#  Base de données (Supabase Postgres)
# ─────────────────────────────────────────────
# URL poolée (pgBouncer) — utilisée par l'application
DATABASE_URL=
# URL directe — utilisée par les migrations Prisma
DIRECT_URL=

# ─────────────────────────────────────────────
#  Supabase (Auth + Storage)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
#  Google My Business (Avis)
# ─────────────────────────────────────────────
# Votre Google Place ID (voir GOOGLE_REVIEWS_SETUP.md)
GOOGLE_PLACE_ID=ChIJxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
#  Service d'emailing (Optionnel)
# ─────────────────────────────────────────────
# Pour Resend (recommandé) - https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
#  Divers
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

